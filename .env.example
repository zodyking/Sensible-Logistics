# =============================================================================
# Container Tracker — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# Dokploy: paste the same keys into the service environment UI.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=production
# 3847 — not 3000. Dokploy's own panel binds host 3000.
PORT=3847
HOST=0.0.0.0
# Product name — brand bar, page titles, and email. Not the legal company name.
NUXT_PUBLIC_APP_NAME=Yard Manager
# Home-screen label when installed as a PWA. Keep it short (~12 characters).
# Baked in at build time, so changing it needs a rebuild.
NUXT_PUBLIC_PWA_SHORT_NAME=Yard Manager
# Install-prompt description for the PWA. Also baked in at build time.
NUXT_PUBLIC_PWA_DESCRIPTION=Yard Manager — driver and yard operations
# Absolute public origin, no trailing slash. Used to build email verification
# links, so it must be the address drivers actually reach. Required in
# production; local development falls back to http://localhost:3000.
NUXT_APP_URL=https://tracker.example.com

# -----------------------------------------------------------------------------
# Session
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 32
# -----------------------------------------------------------------------------
NUXT_SESSION_PASSWORD=change-me-to-a-32-char-or-longer-secret

# -----------------------------------------------------------------------------
# Outbound email (SMTP) — required for driver email verification.
#
# Credentials live here only; they are never stored in the database or editable
# in the app. Point this at a mailbox that already has working SPF, DKIM and
# DMARC. Sending directly from a bare app server usually lands in spam, and many
# hosts block port 25 outright.
#
# The port decides encryption: 587 upgrades with STARTTLS, 465 is implicit TLS.
# Credentials are only sent over an encrypted connection. Leave USER/PASSWORD
# empty only for an unauthenticated relay on your own network.
#
# If NUXT_SMTP_HOST is empty: development logs the verification link to the
# console instead of sending, and production refuses signup with a clear error
# rather than silently stranding a driver.
#
# Verify delivery from Admin → Settings → Email delivery, which reports the mail
# server's own reply.
# -----------------------------------------------------------------------------
NUXT_SMTP_HOST=smtp.example.com
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=smtp-login@example.com
# Where the provider offers app passwords (Gmail, Outlook), use one — an account
# password with 2FA enabled is refused with 535.
NUXT_SMTP_PASSWORD=change-me-smtp-password
# Optional. Defaults to NUXT_SMTP_USER, which is the only From address most
# providers accept. Set it only if yours allows sending as another mailbox.
# NUXT_SMTP_FROM_EMAIL=no-reply@example.com
# Optional display name. Quoted for you, so a comma in the name is safe.
NUXT_SMTP_FROM_NAME=Sensible Logistics

# -----------------------------------------------------------------------------
# Company identity — this deployment serves ONE trucking company.
#
# The invite code is the shared secret a driver types at /signup to join. It is
# operator-owned on purpose: rotating it is a deploy action, not a button in the
# app. Change it whenever a driver leaves, then redeploy — existing accounts are
# unaffected, only new signups use it.
#
# On first boot the app creates the company row from these values, so a fresh
# database needs no seeding. Matching ignores case, spaces and dashes.
# -----------------------------------------------------------------------------
NUXT_COMPANY_INVITE_CODE=change-me-to-a-code-you-share-with-drivers
NUXT_COMPANY_NAME=Your Trucking Company
# Shown on the DOT short-haul time record (49 CFR §395.1(e)(1)):
NUXT_COMPANY_LEGAL_NAME=Your Trucking Company LLC
NUXT_COMPANY_USDOT_NUMBER=
# IANA zone used to render timecard days and the roadside PDF:
NUXT_COMPANY_TIMEZONE=America/New_York
# HOS cycle: SEVENTY_EIGHT (70h/8d) or SIXTY_SEVEN (60h/7d).
NUXT_COMPANY_CYCLE_TYPE=SEVENTY_EIGHT

# -----------------------------------------------------------------------------
# Database (external Postgres)
#
# The app does not start Postgres. Paste a full connection string from Dokploy
# (Database service), your VPS Postgres, or any other PostgreSQL host.
#
# A stock PostgreSQL 14+ server is enough — no extensions are required. The
# geospatial columns are plain latitude/longitude numerics and GeoJSON in jsonb,
# and distances are computed with the haversine formula in SQL.
#
# For local development:
#   docker run -d --name ct-db -p 5432:5432 \
#     -e POSTGRES_USER=tracker -e POSTGRES_PASSWORD=tracker \
#     -e POSTGRES_DB=container_tracker postgres:17
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/container_tracker

# Set to true for managed Postgres that requires TLS. The migrator also honors
# DATABASE_SSL=true. Uses ssl: { rejectUnauthorized: false }.
NUXT_DATABASE_SSL=false
# DATABASE_SSL=false

# -----------------------------------------------------------------------------
# Object storage — SELF-HOSTED SeaweedFS (the `seaweedfs` service in compose).
#
# "S3" here is the wire protocol, not Amazon. SeaweedFS speaks the S3 API, so
# standard clients work against your own container. Nothing leaves your server:
# the endpoint is an internal Docker hostname with no route to the public
# internet, and the access key/secret are values YOU invent for that container.
# Never point these at aws.amazonaws.com or any hosted bucket provider.
# -----------------------------------------------------------------------------
NUXT_S3_ENDPOINT=http://seaweedfs:8333
# Region is a protocol formality SeaweedFS ignores. Leave as-is.
NUXT_S3_REGION=us-east-1
NUXT_S3_BUCKET=container-tracker
NUXT_S3_ACCESS_KEY_ID=change-me-s3-access-key
NUXT_S3_SECRET_ACCESS_KEY=change-me-s3-secret-key

# -----------------------------------------------------------------------------
# Optional Phase-2 services. OCR for container/chassis numbers is built in
# (OpenOCR mobile ONNX: RepViT DB + RepSVTR Mobile on CPU).
# OPENOCR_DET_MODEL=/opt/openocr/openocr_det_model.onnx
# OPENOCR_REC_MODEL=/opt/openocr/openocr_rec_model.onnx
# OPENOCR_WORKER=/app/ocr/openocr_worker.py
#
# All remaining services must be self-hosted containers on the internal network.
# Spec 31.1/31.2 forbids the public tile.openstreetmap.org and
# nominatim.openstreetmap.org endpoints in production.
# -----------------------------------------------------------------------------
# PMTiles archive built locally with Planetiler, served by your own container.
# NUXT_PUBLIC_MAP_TILES_URL=http://tiles:8080/tiles/region.pmtiles
# Self-hosted Nominatim with only your operating region imported.
# NUXT_PUBLIC_GEOCODER_URL=http://nominatim:8080

# -----------------------------------------------------------------------------
# Ops
# Set to true to boot the app without running Drizzle migrations (entrypoint).
# -----------------------------------------------------------------------------
SKIP_MIGRATIONS=false

# -----------------------------------------------------------------------------
# ShipCSX lookup (optional). Playwright uses a persistent mobile profile.
# Lookups send equipment numbers with reference 00. Never books reservations.
# Poll runs every 30 minutes between 5am and 10pm America/New_York when enabled.
# -----------------------------------------------------------------------------
# NUXT_SHIPCSX_POLL=true
# NUXT_SHIPCSX_DEFAULT_TERMINAL=North Bergen
# NUXT_SHIPCSX_PROFILE_DIR=.data/shipcsx-profile
# NUXT_SHIPCSX_EMAIL=
# NUXT_SHIPCSX_PASSWORD=
